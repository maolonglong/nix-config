#!/usr/bin/env bash
set -euo pipefail

if ! command -v nix >/dev/null; then
  echo "Nix is unavailable; run .agents/setup to restore the orb toolchain." >&2
  exit 1
fi

if ! command -v node >/dev/null || ! command -v pnpm >/dev/null; then
  echo "Node.js or pnpm is unavailable; run .agents/setup to restore the orb toolchain." >&2
  exit 1
fi

echo "Orb toolchain is available."
