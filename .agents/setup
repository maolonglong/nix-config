#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
node_version="22.19.0"

log_step() {
  printf '\n==> %s\n' "$1"
}

ensure_apt_packages() {
  local packages=(ca-certificates curl git xz-utils)
  local missing=()
  local package

  for package in "${packages[@]}"; do
    dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed || missing+=("$package")
  done

  if ((${#missing[@]})); then
    log_step "Installing system packages: ${missing[*]}"
    sudo apt-get update
    sudo apt-get install -y "${missing[@]}"
  fi
}

ensure_nix() {
  local installed_version

  if [[ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
    # shellcheck disable=SC1091
    unset __ETC_PROFILE_NIX_SOURCED
    source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  fi
  installed_version="$(nix --version 2>/dev/null | awk '{print $3}' || true)"

  if [[ -n "$installed_version" ]] && [[ "$(printf '%s\n%s\n' 2.18 "$installed_version" | sort -V | head -n1)" == 2.18 ]]; then
    return
  fi

  if dpkg-query -W -f='${db:Status-Status}' nix-bin 2>/dev/null | grep -qx installed; then
    log_step "Removing the outdated Debian Nix package"
    sudo systemctl stop nix-daemon.service nix-daemon.socket || true
    sudo apt-get purge -y nix-bin nix-setup-systemd
    while IFS=: read -r username _ uid gid _; do
      if [[ "$username" == nixbld* ]]; then
        sudo userdel "$username"
      fi
    done < <(getent passwd)
    sudo groupdel nixbld || true
    sudo rm -rf /nix
  fi

  log_step "Installing current Nix with flakes enabled"
  curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix |
    sh -s -- install linux --no-confirm --diagnostic-endpoint=""
}

ensure_nix_login_profile() {
  local profile_marker="# nix-config Nix profile v2"

  if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'EOF'

# nix-config Nix profile v2
if [[ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]]; then
  unset __ETC_PROFILE_NIX_SOURCED
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
EOF
  fi
}

ensure_node() {
  if [[ "$(node --version 2>/dev/null || true)" == "v${node_version}" ]]; then
    return
  fi

  log_step "Installing Node.js ${node_version}"
  local archive="node-v${node_version}-linux-x64.tar.xz"
  local download_dir
  download_dir="$(mktemp -d)"
  trap 'rm -rf "$download_dir"' RETURN
  curl --fail --location --retry 3 --output "$download_dir/$archive" \
    "https://nodejs.org/dist/v${node_version}/${archive}"
  sudo tar --extract --xz --file "$download_dir/$archive" --directory /usr/local --strip-components=1
  rm -rf "$download_dir"
  trap - RETURN
}

log_step "Preparing Amp orb dependencies"
ensure_apt_packages
ensure_nix
ensure_nix_login_profile
ensure_node

log_step "Enabling pnpm"
corepack enable pnpm

log_step "Installing upstream-watch dependencies"
cd "$repo_root/automation/upstream-watch"
pnpm install --frozen-lockfile

log_step "Setup complete"
